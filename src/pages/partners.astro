---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { partners } from '../data/partners';
import { site } from '../data/site';
---

<Base title="Partners" description="The companies Quantum ByTech works with to deliver websites, stores, apps and social media for clients.">
  <section class="page-hero">
    <div class="wrap">
      <h1>The partners behind our work.</h1>
      <p class="lead">
        The apps, agencies and brands we work alongside, from live audio and digital invitations to fine jewelry and
        fashion.
      </p>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      {partners.length > 0 ? (
        <ul class="partners">
          {partners.map((p) => (
            <li>
              <div class:list={['logo', { dark: p.darkTile, icon: p.logoStyle === 'icon' }]} aria-hidden="true">
                {p.logo ? (
                  <img
                    src={p.logo}
                    alt=""
                    loading="lazy"
                    style={p.logoWidth && `width:${p.logoWidth};max-width:none;max-height:none`}
                  />
                ) : (
                  <span class="wordmark">{p.name}</span>
                )}
              </div>
              <h2>{p.name}</h2>
              <p>{p.description}</p>
              {p.url && <a href={p.url} target="_blank" rel="noopener">Visit {p.name}</a>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">Our partner list is being updated.</p>
      )}
    </div>
  </section>

  <section class="section">
    <div class="wrap become">
      <div>
        <h2>Become a partner</h2>
        <p>If your product or service would help our clients, we would like to hear from you.</p>
      </div>
      <a class="btn btn--ghost" href={`mailto:${site.email}?subject=Partnership`}>Email us about partnering</a>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .page-hero { padding-block: clamp(64px, 9vw, 120px) clamp(48px, 6vw, 80px); }
  h1 { max-width: 15ch; }
  .lead { margin-top: 24px; }

  .partners {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px 40px;
  }
  .partners li { display: grid; gap: 10px; align-content: start; }
  .logo {
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 2;
    padding: 32px;
    margin-bottom: 8px;
    background: var(--paper);
    border-radius: 8px;
  }
  .logo img { max-height: 96px; max-width: 75%; width: auto; height: auto; object-fit: contain; }
  .logo.dark { background: var(--pine); }
  .logo.dark img { width: 58%; max-width: none; max-height: none; }
  .logo.icon img { width: 128px; max-height: none; aspect-ratio: 1; border-radius: 22%; }
  .wordmark { font-size: var(--step-2); font-weight: 700; letter-spacing: -0.03em; color: var(--pine); }
  .partners h2 { font-size: var(--step-1); font-weight: 600; letter-spacing: -0.01em; }
  .partners p { color: var(--muted); }
  .partners a { color: var(--pine); font-weight: 600; text-underline-offset: 4px; }
  .empty { color: var(--muted); }

  @media (max-width: 880px) { .partners { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .partners { grid-template-columns: 1fr; } }

  .become { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px 64px; flex-wrap: wrap; }
  .become p { margin-top: 12px; color: var(--muted); font-size: var(--step-1); max-width: 48ch; }
</style>
