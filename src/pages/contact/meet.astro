    position: absolute;
    left: 0;
    top: 0.58em;
    width: 12px;
    height: 4px;
    background: var(--signal);
  }
  .agenda p { margin-top: 18px; font-size: var(--step--1); color: var(--on-pine-muted); }

  .info-foot { position: relative; z-index: 1; margin-top: auto; font-size: var(--step--1); color: var(--on-pine-muted); }
  .info-foot a { color: var(--white); font-weight: 600; text-underline-offset: 4px; }
  .nowrap { white-space: nowrap; }

  .info :global(.info-mark) {
