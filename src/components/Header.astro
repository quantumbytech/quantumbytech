---
import { nav, site } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => !href.includes('#') && path.startsWith(href);
---

<header class="site-header">
  <div class="wrap inner">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <img src="/brand/logo-classic.svg" alt={site.name} width="146" height="62" />
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="menu-label visually-hidden">Open menu</span>
      <span class="burger" aria-hidden="true">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </span>
    </button>

    <nav class="nav" id="site-nav" aria-label="Main">
      {nav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="btn btn--primary nav-cta" href="/contact/">Request a quote</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('site-nav');
  const label = toggle?.querySelector('.menu-label');

  function setOpen(open: boolean) {
    nav?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    if (label) label.textContent = open ? 'Close menu' : 'Open menu';
  }

  toggle?.addEventListener('click', () => setOpen(!nav?.classList.contains('is-open')));
  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || !nav?.classList.contains('is-open')) return;
    setOpen(false);
    toggle?.focus();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 90%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .inner { display: flex; align-items: center; height: var(--header-h); }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--pine);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
  }
  .brand img { display: block; height: 62px; width: auto; }

  .nav { display: flex; align-items: center; gap: 30px; margin-left: auto; }
  .nav a:not(.btn) {
    text-decoration: none;
    color: var(--ink);
    font-weight: 500;
    text-underline-offset: 8px;
    text-decoration-thickness: 2px;
  }
  .nav a:not(.btn):hover,
  .nav a[aria-current='page'] { color: var(--pine); text-decoration-line: underline; }
  .nav-cta { min-height: 42px; padding: 0 18px; margin-left: 4px; }

  .menu-toggle {
    display: none;
    position: relative;
    margin-left: auto;
    margin-right: -8px; /* pulls the bars to the content edge; tap target stays 44px */
    width: 44px;
    height: 44px;
    padding: 0;
    background: none;
    border: 0;
    border-radius: var(--radius);
    color: var(--pine);
    cursor: pointer;
    align-items: center;
    justify-content: center;
  }
  .menu-toggle:hover { color: var(--pine-hover); }

  .burger { position: relative; display: block; width: 24px; height: 16px; }
  .bar {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    transition: transform 220ms ease, opacity 220ms ease, top 220ms ease;
  }
  .bar:nth-child(1) { top: 0; }
  .bar:nth-child(2) { top: 7px; }
  .bar:nth-child(3) { top: 14px; }

  .menu-toggle[aria-expanded='true'] .bar:nth-child(1) { top: 7px; transform: rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .bar:nth-child(2) { opacity: 0; }
  .menu-toggle[aria-expanded='true'] .bar:nth-child(3) { top: 7px; transform: rotate(-45deg); }

  @media (prefers-reduced-motion: reduce) {
    .bar { transition: none; }
  }

  @media (max-width: 880px) {
    .menu-toggle { display: inline-flex; }
    .nav {
      display: none;
      position: absolute;
      top: var(--header-h);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px var(--gutter) 24px;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
    }
    .nav:global(.is-open) { display: flex; }
    .nav a:not(.btn) { padding: 14px 0; border-bottom: 1px solid var(--line); font-size: var(--step-1); }
    .nav-cta { margin: 20px 0 0; min-height: 48px; }
  }
</style>
