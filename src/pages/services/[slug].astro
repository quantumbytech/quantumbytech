---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import ServiceList from '../../components/ServiceList.astro';
import Process from '../../components/Process.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { services, type Service } from '../../data/services';
import { site } from '../../data/site';

export const getStaticPaths = (() =>
  services.map((service) => ({ params: { slug: service.slug }, props: { service } }))) satisfies GetStaticPaths;

const { service } = Astro.props as { service: Service };
const pageUrl = new URL(`/services/${service.slug}/`, Astro.site).href;

const schema = [
  {
    '@type': 'Service',
    '@id': `${pageUrl}#service`,
    name: service.name,
    serviceType: service.seoTitle.replace(/ in Lebanon$/, ''),
    description: service.seoDescription,
    url: pageUrl,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: { '@type': 'Country', name: 'Lebanon' },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Services', item: `${site.url}/services/` },
      { '@type': 'ListItem', position: 3, name: service.name, item: pageUrl },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: service.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base title={service.seoTitle} description={service.seoDescription} schema={schema}>
  <section class="page-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/services/">Services</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{service.name}</span>
      </nav>
      <h1>{service.title}</h1>
      <p class="lead">{service.lead}</p>
      <div class="actions">
        <a class="btn btn--primary" href={`/contact/?service=${service.slug}`}>Request a quote</a>
        <a class="btn btn--ghost" href={site.whatsapp} target="_blank" rel="noopener">Message us on WhatsApp</a>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <div class="section-head">
        <h2>What is included</h2>
      </div>
      <ul class="includes">
        {service.includes.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="section-head">
        <h2>A good fit if</h2>
      </div>
      <ul class="fit">
        {service.fitFor.map((line) => <li>{line}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <div class="section-head">
        <h2>How the project runs</h2>
        <p>A fixed price and a timeline before we start, and progress you can see every week.</p>
      </div>
      <Process />
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="section-head">
        <h2>Questions about {service.name.toLowerCase()}</h2>
      </div>
      <Faq items={service.faqs} />
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <div class="section-head">
        <h2>Other services</h2>
      </div>
      <ServiceList exclude={service.slug} />
    </div>
  </section>

  <CtaBand title={`Start your ${service.name.toLowerCase()} project`} />
</Base>

<style>
  .page-hero { padding-block: clamp(48px, 7vw, 96px) clamp(64px, 9vw, 120px); }
  .crumbs { display: flex; gap: 10px; margin-bottom: 32px; color: var(--muted); font-size: var(--step--1); }
  .crumbs a { color: var(--pine); font-weight: 600; text-underline-offset: 4px; }
  h1 { max-width: 18ch; }
  .lead { margin-top: 24px; }
  .actions { margin-top: 36px; }

  .includes {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px 40px;
  }
  .includes li { padding-top: 20px; border-top: 1px solid var(--line); }
  .includes h3 { font-size: var(--step-0); margin-bottom: 8px; }
  .includes p { color: var(--muted); }
  @media (max-width: 880px) { .includes { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .includes { grid-template-columns: 1fr; gap: 32px; } }

  .split { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: 32px 80px; align-items: start; }
  .split .section-head { margin-bottom: 0; }
  @media (max-width: 880px) { .split { grid-template-columns: 1fr; } }

  .fit { list-style: none; border-top: 1px solid var(--line); }
  .fit li {
    display: flex;
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--step-1);
    color: var(--pine);
  }
  .fit li::before {
    content: '';
    flex: none;
    width: 10px;
    height: 10px;
    margin-top: 0.55em;
    background: var(--signal);
  }
</style>
