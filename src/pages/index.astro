---
import Base from '../layouts/Base.astro';
import ServiceList from '../components/ServiceList.astro';
import Process from '../components/Process.astro';
import Principles from '../components/Principles.astro';
import Work from '../components/Work.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, faqs } from '../data/site';

const schema = [
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base schema={schema}>
  <section class="hero">
    <!-- A silent loop of how we work. The poster shows at once; the video starts only after the page has loaded,
         and never for visitors who ask for less motion or for saving data. -->
    <video
      class="hero-video"
      muted
      loop
      playsinline
      preload="none"
      poster="/video/hero-poster.jpg"
      aria-hidden="true"
      tabindex="-1"
      data-hero-video
    >
      <source src="/video/hero.webm" type="video/webm" />
      <source src="/video/hero.mp4" type="video/mp4" />
    </video>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap">
      <h1>Websites and apps that make your business easier to buy from.</h1>
      <p class="lead">
        Quantum ByTech is a digital studio in Beirut. We design, build and look after websites, online stores and
        mobile apps, and run the social media that brings customers to them.
      </p>
      <div class="actions">
        <a class="btn btn--light" href="/contact/">Request a quote</a>
        <a class="btn btn--outline-light" href={site.whatsapp} target="_blank" rel="noopener">Message us on WhatsApp</a>
      </div>
    </div>
  </section>

  <script>
    const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
    if (video && !calm.matches && !saveData) {
      const start = () => {
        video.preload = 'auto';
        video.play().catch(() => {
          /* Autoplay refused: the poster stays, which is fine */
        });
      };
      if (document.readyState === 'complete') start();
      else window.addEventListener('load', start, { once: true });
      calm.addEventListener('change', () => calm.matches && video.pause());
    }
  </script>

  <section class="section section--white" id="services">
    <div class="wrap">
      <div class="section-head">
        <h2>What we build</h2>
        <p>Six services, one team. Start with one and add the rest as you grow.</p>
      </div>
      <ServiceList />
    </div>
  </section>

  <Work />

  <section class="section section--white" id="process">
    <div class="wrap">
      <div class="section-head">
        <h2>How a project runs</h2>
        <p>You always know what happens next, what it costs and when it will be ready.</p>
      </div>
      <Process />
    </div>
  </section>

  <section class="section section--pine">
    <div class="wrap">
      <div class="section-head">
        <h2>Why businesses work with us</h2>
        <p>We are a small team on purpose. The people you meet on the first call are the people who build your project.</p>
      </div>
      <Principles />
    </div>
  </section>

  <section class="section" id="faq">
    <div class="wrap faq-layout">
      <div class="section-head">
        <h2>Common questions</h2>
        <p>Anything else, <a href={site.whatsapp} target="_blank" rel="noopener">ask us on WhatsApp</a>.</p>
      </div>
      <Faq items={faqs} />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* The hero: a dark band with the "how we work" loop behind the text. The shade keeps the text side dark
     whatever the frame shows, and fades the right side less so the footage stays visible. */
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: #04110c url('/video/hero-poster.jpg') center / cover no-repeat;
    color: var(--on-pine);
    padding-block: clamp(72px, 11vw, 152px) clamp(80px, 12vw, 168px);
  }
  .hero-video {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(4, 17, 12, 0.94) 0%, rgba(4, 17, 12, 0.86) 34%, rgba(4, 17, 12, 0.5) 64%, rgba(4, 17, 12, 0.28) 100%),
      linear-gradient(0deg, rgba(4, 17, 12, 0.55) 0%, rgba(4, 17, 12, 0) 40%);
  }
  .hero .wrap { position: relative; }
  .hero h1 { max-width: 13ch; color: var(--white); }
  .hero .lead { margin-top: 28px; color: var(--on-pine); }
  .hero .actions { margin-top: 40px; }
  .hero :focus-visible { outline-color: var(--signal); }
  .btn--outline-light { background: transparent; color: var(--white); border-color: rgba(255, 255, 255, 0.7); }
  .btn--outline-light:hover { background: rgba(255, 255, 255, 0.12); border-color: var(--white); }

  /* On a phone the text spans the width, so the shade is even all over */
  @media (max-width: 880px) {
    .hero-shade { background: linear-gradient(180deg, rgba(4, 17, 12, 0.7) 0%, rgba(4, 17, 12, 0.8) 100%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-video { display: none; }
  }

  .faq-layout { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: 48px 80px; align-items: start; }
  .faq-layout .section-head { margin-bottom: 0; }
  .faq-layout a { color: var(--pine); font-weight: 600; text-underline-offset: 4px; }
  @media (max-width: 880px) {
    .faq-layout { grid-template-columns: 1fr; }
  }
</style>
