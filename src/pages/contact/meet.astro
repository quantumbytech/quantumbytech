    font: 600 var(--step-0) / 1.15 var(--font);

    cursor: pointer;
    transition: background-color 0.15s, border-color 0.15s, color 0.15s;
  }
  .times :global(.time:hover) { border-color: var(--pine); }
  .times :global(.time[aria-pressed='true']) { background: var(--pine); border-color: var(--pine); color: var(--white); }
  .times :global(.time-day) { margin-left: 4px; font-size: 0.75rem; font-weight: 500; }
  .times :global(.hint) { font-size: 0.8125rem; font-weight: 400; color: var(--muted); }
  .times :global(.time[aria-pressed='true'] .hint) { color: var(--on-pine-muted); }

  /* Loading placeholders */
  .card :global(.sk) {
    display: block;
    border-radius: var(--radius);
    background: linear-gradient(90deg, #edf1ee 30%, #f6f8f6 50%, #edf1ee 70%);
    background-size: 300% 100%;
    animation: shimmer 1.4s ease-in-out infinite;
  }
  .card :global(.sk-day),
  .card :global(.sk-time) { height: 50px; }
  .card :global(.sk-line) { width: 180px; max-width: 100%; height: 1.1em; margin-top: 0.25em; }
  @keyframes shimmer {
    from { background-position: 100% 0; }
    to { background-position: 0 0; }
  }

  /* Error and empty states */
  .state { display: grid; justify-items: start; gap: 14px; max-width: 48ch; padding-block: 8px 4px; }
  .state h2 { font-size: var(--step-1); letter-spacing: -0.01em; }
  .state p { color: var(--muted); }
  .state .actions { margin-top: 8px; }
  .state-alt a { color: var(--pine); font-weight: 600; text-underline-offset: 4px; }
  .state-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--mint);
    color: var(--pine);
  }
  .state-icon--warn { background: #fbecea; color: #a3261b; }

  /* Continue bar: stays in reach at the bottom of the screen while scrolling the picker */
  .bar {
    position: sticky;
    bottom: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
    margin: auto calc(-1 * var(--fp)) calc(-1 * var(--fp));
    padding: 16px var(--fp);
    padding-bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    background: var(--white);
    border-top: 1px solid var(--line);
    border-radius: 0 0 11px 0;
  }
  .bar-text { color: var(--muted); }
  .bar.is-ready .bar-text { color: var(--pine); font-weight: 600; }
  .bar .btn { flex: none; min-width: 148px; }
  .btn:disabled { opacity: 0.4; cursor: not-allowed; }

  /* Step 3 form, matching the contact form */
  .view--details { display: grid; align-content: start; gap: 24px; }
  .view--details .step-head { margin-bottom: -4px; }
  .chosen {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 12px 12px 16px;
    background: var(--mint);
    border-radius: var(--radius);
  }
  .chosen-icon { flex: none; color: var(--pine); }
  .chosen-text { min-width: 0; }
  .chosen-main { font-weight: 600; color: var(--pine); line-height: 1.4; }
  .chosen-sub { color: var(--ink); line-height: 1.4; }
  .chosen-hint { margin-top: 2px; font-size: var(--step--1); color: var(--muted); }
  .chosen-hint:empty { display: none; }
  .link-btn {
    flex: none;
    margin-left: auto;
    min-height: 44px;
    padding: 0 10px;
