---
import Base from '../../layouts/Base.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import CtaBand from '../../components/CtaBand.astro';
import { work } from '../../data/work';
import { site } from '../../data/site';

const schema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Work', item: `${site.url}/work/` },
    ],
  },
  {
    '@type': 'ItemList',
    name: 'Case studies',
    itemListElement: work.map((w, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: w.project.client,
      url: `${site.url}/work/${w.slug}/`,
    })),
  },
];
---

<Base
  title="Our Work: Websites, Stores and Apps"
  description="Case studies from Quantum ByTech in Beirut: GalaCards, Bechara Issa, Kelly Rissi, Khatwa, Radyofone and dlimits. What we built and how it works for customers."
  schema={schema}
>
  <section class="page-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Work</span>
      </nav>
      <h1>Websites, stores and apps we have built.</h1>
      <p class="lead">
        Six projects, each with what the client does, what we built and how it works for their customers. Pick one
        that looks like your business.
      </p>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <WorkGrid />
    </div>
  </section>

  <CtaBand title="Want a project like these?" />
</Base>

<style>
  .page-hero { padding-block: clamp(48px, 7vw, 96px) clamp(48px, 6vw, 80px); }
  .crumbs { display: flex; gap: 10px; margin-bottom: 32px; color: var(--muted); font-size: var(--step--1); }
  .crumbs a { color: var(--pine); font-weight: 600; text-underline-offset: 4px; }
  h1 { max-width: 15ch; }
  .lead { margin-top: 24px; }
</style>
