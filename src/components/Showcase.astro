---
// Illustration of a store built on web and mobile, drawn in brand colours.
---

<figure class="showcase">
  <svg viewBox="0 0 1200 680" role="img" aria-labelledby="showcase-title">
    <title id="showcase-title">An online store shown in a desktop browser and on a phone</title>
    <defs>
      <clipPath id="browser-clip"><rect x="40" y="60" width="820" height="560" rx="14"></rect></clipPath>
    </defs>

    <!-- Browser -->
    <g clip-path="url(#browser-clip)">
      <rect x="40" y="60" width="820" height="560" fill="#fff"></rect>
      <rect x="40" y="60" width="820" height="44" fill="#f3f5f2"></rect>
      <circle cx="68" cy="82" r="6" fill="#d5ddd8"></circle>
      <circle cx="88" cy="82" r="6" fill="#d5ddd8"></circle>
      <circle cx="108" cy="82" r="6" fill="#d5ddd8"></circle>
      <rect x="290" y="72" width="320" height="20" rx="10" fill="#fff" stroke="#d5ddd8"></rect>

      <circle cx="86" cy="140" r="9" fill="none" stroke="#0b3d2e" stroke-width="5"></circle>
      <rect x="86" y="138" width="14" height="5" fill="#1fc77a"></rect>
      <rect x="108" y="134" width="84" height="12" rx="3" fill="#0b3d2e"></rect>
      <rect x="500" y="135" width="44" height="10" rx="3" fill="#c9d3cd"></rect>
      <rect x="560" y="135" width="44" height="10" rx="3" fill="#c9d3cd"></rect>
      <rect x="620" y="135" width="44" height="10" rx="3" fill="#c9d3cd"></rect>
      <rect x="700" y="126" width="96" height="28" rx="5" fill="#0b3d2e"></rect>

      <rect x="76" y="200" width="360" height="26" rx="4" fill="#0b3d2e"></rect>
      <rect x="76" y="238" width="300" height="26" rx="4" fill="#0b3d2e"></rect>
      <rect x="76" y="290" width="340" height="10" rx="3" fill="#c9d3cd"></rect>
      <rect x="76" y="308" width="280" height="10" rx="3" fill="#c9d3cd"></rect>
      <rect x="76" y="340" width="120" height="36" rx="6" fill="#0b3d2e"></rect>
      <rect x="207" y="341" width="118" height="34" rx="6" fill="none" stroke="#0b3d2e" stroke-width="1.5"></rect>

      <rect x="480" y="180" width="316" height="210" rx="8" fill="#e1f0e6"></rect>
      <circle cx="638" cy="285" r="62" fill="#c6e3d0"></circle>
      <rect x="638" y="279" width="96" height="14" fill="#1fc77a"></rect>

      <rect x="76" y="420" width="166" height="110" rx="8" fill="#f3f5f2"></rect>
      <rect x="262" y="420" width="166" height="110" rx="8" fill="#f3f5f2"></rect>
      <rect x="448" y="420" width="166" height="110" rx="8" fill="#f3f5f2"></rect>
      <rect x="634" y="420" width="166" height="110" rx="8" fill="#f3f5f2"></rect>
      <rect x="76" y="546" width="120" height="10" rx="3" fill="#c9d3cd"></rect>
      <rect x="262" y="546" width="100" height="10" rx="3" fill="#c9d3cd"></rect>
      <rect x="448" y="546" width="130" height="10" rx="3" fill="#c9d3cd"></rect>
      <rect x="634" y="546" width="110" height="10" rx="3" fill="#c9d3cd"></rect>
