---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { partners } from '../data/partners';
---

<Base
  title="Our Clients and Recent Projects"
  description="Brands that trust Quantum ByTech: Radyofone, Khatwa, GalaCards, dlimits, Bechara Issa and Kelly Rissi. See the websites, apps and stores we have built."
>
  <section class="page-hero">
    <div class="wrap">
      <h1>Brands that trust us with their digital work.</h1>
      <p class="lead">
        We design, build and look after websites, apps and online stores for these businesses, from live radio and
        step rewards to digital invitations, fine jewelry and fashion.
      </p>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      {partners.length > 0 ? (
        <ul class="partners">
          {partners.map((p) => (
            <li>
              <div class:list={['logo', { dark: p.darkTile, icon: p.logoStyle === 'icon' }]} aria-hidden="true">
                {p.logo ? (
                  <img
                    src={p.logo}
                    alt=""
                    width={p.logoSize?.[0]}
                    height={p.logoSize?.[1]}
                    loading="lazy"
                    style={p.logoWidth && `width:${p.logoWidth};max-width:none;max-height:none`}
                  />
                ) : (
                  <span class="wordmark">{p.name}</span>
                )}
              </div>
              <h2>{p.name}</h2>
              <p>{p.description}</p>
              {p.url && <a href={p.url} target="_blank" rel="noopener">Visit {p.name}</a>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">Our client list is being updated.</p>
      )}
    </div>
  </section>

  <CtaBand title="Want your brand on this page?" />
</Base>

<style>
  .page-hero { padding-block: clamp(64px, 9vw, 120px) clamp(48px, 6vw, 80px); }
  h1 { max-width: 15ch; }
  .lead { margin-top: 24px; }

  .partners {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px 40px;
  }
  .partners li { display: grid; gap: 10px; align-content: start; }
  .logo {
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 2;
    padding: 32px;
    margin-bottom: 8px;
    background: var(--paper);
    border-radius: 8px;
  }
  .logo img { max-height: 96px; max-width: 75%; width: auto; height: auto; object-fit: contain; }
  .logo.dark { background: var(--pine); }
  .logo.dark img { width: 58%; max-width: none; max-height: none; }
  .logo.icon img { width: 128px; max-height: none; aspect-ratio: 1; border-radius: 22%; }
  .wordmark { font-size: var(--step-2); font-weight: 700; letter-spacing: -0.03em; color: var(--pine); }
  .partners h2 { font-size: var(--step-1); font-weight: 600; letter-spacing: -0.01em; }
  .partners p { color: var(--muted); }
  .partners a { color: var(--pine); font-weight: 600; text-underline-offset: 4px; }
  .empty { color: var(--muted); }

  @media (max-width: 880px) { .partners { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .partners { grid-template-columns: 1fr; } }

</style>
