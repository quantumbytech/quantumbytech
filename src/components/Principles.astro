---
import { principles } from '../data/site';
---

<div class="principles">
  {principles.map((p) => (
    <div>
      <h3>{p.title}</h3>
      <p>{p.text}</p>
    </div>
  ))}
</div>

<style>
  .principles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .principles > div { padding-inline: 32px; border-left: 1px solid var(--on-pine-line); }
  .principles > div:first-child { padding-left: 0; border-left: 0; }
  h3 { margin-bottom: 12px; }
  p { max-width: 36ch; }

  @media (max-width: 880px) {
    .principles { grid-template-columns: 1fr; gap: 0; }
    .principles > div,
    .principles > div:first-child { padding: 28px 0; border-left: 0; border-top: 1px solid var(--on-pine-line); }
  }
</style>
