---
import Base from '../layouts/Base.astro';
import Principles from '../components/Principles.astro';
import Process from '../components/Process.astro';
import CtaBand from '../components/CtaBand.astro';
---

<Base
  title="About"
  description="Quantum ByTech is a small digital studio in Beirut that designs, builds and supports websites, online stores, apps and social media."
>
  <section class="page-hero">
    <div class="wrap">
      <h1>A small studio that helps growing businesses sell and work online.</h1>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap story">
      <h2>What we do</h2>
      <div class="copy">
        <p>
          Quantum ByTech is a digital studio based in Beirut. We design and build websites, online stores, mobile apps
          and internal tools, and run social media for businesses that want technology to make their work easier, not
          more complicated.
        </p>
        <p>
          We start by understanding how your business actually runs: who your customers are, how they find you and what
          slows your team down. Then we propose the simplest thing that solves it, with a fixed price and a clear
          timeline.
        </p>
        <p>
          After launch we stay involved. Most of what we build keeps growing, and we would rather improve it with you
          than hand it over and disappear.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--pine">
    <div class="wrap">
      <div class="section-head">
        <h2>How we work with clients</h2>
      </div>
      <Principles />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>From first call to launch</h2>
        <p>Five steps, the same for every project.</p>
      </div>
      <Process />
    </div>
  </section>

  <CtaBand title="Let's talk about your project" />
</Base>

<style>
  .page-hero { padding-block: clamp(64px, 9vw, 120px); }
  h1 { max-width: 16ch; }

  .story { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: 32px 80px; }
  .copy { display: grid; gap: 20px; font-size: var(--step-1); line-height: 1.6; max-width: 60ch; }
  @media (max-width: 880px) { .story { grid-template-columns: 1fr; } }
</style>
