---
import WorkGrid from './WorkGrid.astro';
import { work } from '../data/work';
---

{work.length > 0 && (
  <section class="section" id="work">
    <div class="wrap">
      <div class="section-head">
        <h2>Recent work</h2>
        <p>Websites, stores, platforms and apps we have designed and built. <a href="/work/">Read the case studies</a>.</p>
      </div>
      <WorkGrid />
    </div>
  </section>
)}

<style>
  .section-head a { color: var(--pine); font-weight: 600; text-underline-offset: 4px; }
</style>
