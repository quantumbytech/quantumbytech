---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <section class="not-found">
    <div class="wrap">
      <h1>This page does not exist.</h1>
      <p class="lead">The link may be old, or the address may have a typo. Try one of these instead.</p>
      <div class="actions">
        <a class="btn btn--primary" href="/">Go to the home page</a>
        <a class="btn btn--ghost" href="/services/">See our services</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .not-found { padding-block: clamp(96px, 14vw, 180px); }
  h1 { max-width: 14ch; }
  .lead { margin-top: 24px; }
  .actions { margin-top: 36px; }
</style>
