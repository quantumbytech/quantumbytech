  .view--pick .state { margin-bottom: 36px; }
  .noscript { color: var(--muted); }
  .noscript a { color: var(--pine); font-weight: 600; }

  .step-head { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; min-height: 30px; }
