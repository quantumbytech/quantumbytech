    <rect x="910" y="628" width="90" height="5" rx="2.5" fill="#c9d3cd"></rect>
  </svg>
</figure>

<style>
  .showcase {
    margin: 0;
    padding: clamp(16px, 4vw, 48px) clamp(8px, 3vw, 40px) 0;
    background: var(--mint);
    border-radius: 12px;
    overflow: hidden;
  }
  svg { width: 100%; height: auto; }
</style>
