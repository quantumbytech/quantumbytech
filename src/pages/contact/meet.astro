  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  legend,
  .field label { display: block; margin-bottom: 10px; padding: 0; font-weight: 600; color: var(--pine); }
  .optional { font-weight: 400; color: var(--muted); }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  @container (max-width: 520px) {
    .row { grid-template-columns: 1fr; gap: 24px; }
  }

  input:not([type='radio']),
  textarea {
    width: 100%;
    padding: 12px 14px;
    font: inherit;
    color: var(--ink);
    background: var(--white);
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  input:not([type='radio']):focus,
  textarea:focus { border-color: var(--pine); outline: none; box-shadow: 0 0 0 3px var(--mint); }
  input[aria-invalid='true'] { border-color: #a3261b; }
  textarea { resize: vertical; min-height: 120px; }
  .err { margin-top: 6px; font-size: var(--step--1); color: #a3261b; }
  .err:empty { display: none; }

  .chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .chip { position: relative; }
  .chip input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .chip span {
    display: block;
    padding: 10px 16px;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    line-height: 1.4;
    transition: border-color 0.15s, background-color 0.15s, color 0.15s;
  }
  .chip:hover span { border-color: var(--pine); }
  .chip input:checked + span { background: var(--pine); border-color: var(--pine); color: var(--white); }
  .chip input:focus-visible + span { outline: 3px solid var(--pine); outline-offset: 3px; }

  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .submit { display: flex; align-items: center; gap: 14px 20px; flex-wrap: wrap; margin-top: 4px; }
  .status { color: var(--pine); font-weight: 600; }
  .status:empty { display: none; }
  .status:global(.is-error) { color: #a3261b; font-weight: 500; }
  .status :global(a) { color: inherit; font-weight: 600; text-underline-offset: 3px; }
  .small { margin-top: -8px; font-size: var(--step--1); color: var(--muted); }
  .small a { color: var(--pine); text-underline-offset: 3px; }

  /* Done */
  .view--done { max-width: 56ch; padding-block: 8px; }
  .done-icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--mint);
    color: var(--pine);
  }
  .view--done h2 { margin-top: 22px; font-size: var(--step-2); }
  .view--done h2:focus { outline: none; }
  .done-lead { margin-top: 14px; font-size: var(--step-1); line-height: 1.5; color: var(--ink); }
  .done-lead strong { color: var(--pine); overflow-wrap: anywhere; }
  .done-local { margin-top: 8px; color: var(--muted); }
  .view--done h3 { margin-top: 36px; padding-top: 28px; border-top: 1px solid var(--line); font-size: var(--step-0); font-weight: 600; letter-spacing: 0; }
  .next { list-style: none; counter-reset: step; display: grid; gap: 14px; margin-top: 16px; }
  .next li { position: relative; padding-left: 40px; counter-increment: step; color: var(--muted); }
  .next li strong { color: var(--ink); font-weight: 600; }
  .next li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--mint);
    color: var(--pine);
    font-size: var(--step--1);
    font-weight: 700;
  }
  .done-foot { margin-top: 24px; color: var(--muted); }
  .done-foot a { color: var(--pine); font-weight: 600; text-underline-offset: 4px; }
  .view--done .btn { margin-top: 28px; }

  /* Tablet and phone: one column, the call details on top */
  @media (max-width: 960px) {
    .card { grid-template-columns: 1fr; }
    .info { gap: 20px; border-radius: 11px 11px 0 0; }
    .info h1 { max-width: 18ch; }
    .agenda { display: none; }
    .info :global(.info-mark) { width: 300px; right: -120px; bottom: -158px; }
    .bar { border-radius: 0 0 11px 11px; }
  }

  /* Phone: edge to edge, primary buttons full width */
  @media (max-width: 640px) {
    .meet { padding-block: 0 56px; }
    .meet .wrap { width: 100%; }
    .card { border: 0; border-bottom: 1px solid var(--line); border-radius: 0; }
    .info { border-radius: 0; padding: 28px 16px; }
    .info h1 { font-size: 1.875rem; }
    .flow { --fp: 16px; padding-top: 28px; }
    .bar { border-radius: 0; box-shadow: 0 -10px 24px -12px rgba(11, 61, 46, 0.18); }
    .bar-text { font-size: var(--step--1); }
    .bar .btn { min-width: 128px; }
    .days { gap: 4px; }
    .weekdays { gap: 4px; }
    .submit .btn { width: 100%; }
    .chosen { padding-left: 14px; gap: 12px; }
  }
</style>
