---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="faq">
  {items.map((item) => (
    <details>
      <summary>
        <span>{item.q}</span>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12M10 4v12" /></svg>
      </summary>
      <p>{item.a}</p>
    </details>
  ))}
</div>

<style>
  .faq { border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 22px 0;
    cursor: pointer;
    list-style: none;
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--pine);
    letter-spacing: -0.01em;
  }
  summary::-webkit-details-marker { display: none; }
  svg {
    flex: none;
    width: 20px;
    height: 20px;
    stroke: currentColor;
    stroke-width: 2;
    transition: transform 0.2s ease;
  }
  details[open] svg { transform: rotate(45deg); }
  p { padding-bottom: 24px; color: var(--muted); max-width: 64ch; }
</style>
