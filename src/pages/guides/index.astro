---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { guides } from '../../data/guides';
import { site } from '../../data/site';

const pageUrl = new URL('/guides/', Astro.site).href;
const schema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: pageUrl },
    ],
  },
  {
    '@type': 'ItemList',
    itemListElement: guides.map((g, i) => ({ '@type': 'ListItem', position: i + 1, url: `${site.url}/guides/${g.slug}/`, name: g.h1 })),
  },
];
---

<Base
  title="Guides for Business Owners in Lebanon"
  description="Plain answers to the questions business owners ask before a website, online store, app or CRM: what it costs, what you need, and how to start."
  schema={schema}
>
  <section class="page-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Guides</span>
      </nav>
      <h1>Guides for business owners.</h1>
      <p class="lead">Plain answers to the questions we hear before every project: what it costs, what you need, and how to start.</p>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <ul class="list">
        {guides.map((g) => (
          <li>
            <a href={`/guides/${g.slug}/`}>
              <h2>{g.h1}</h2>
              <p>{g.seoDescription}</p>
              <span class="more">Read the guide · {g.minutes} min</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .crumbs { display: flex; gap: 10px; margin-bottom: 32px; color: var(--muted); font-size: var(--step--1); }
  .crumbs a { color: var(--pine); font-weight: 600; text-underline-offset: 4px; }
  .list { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr)); gap: 20px; }
  .list a { display: grid; gap: 10px; height: 100%; padding: 24px; border: 1px solid var(--line); border-radius: 12px; text-decoration: none; background: var(--paper); }
  .list a:hover { border-color: var(--pine); }
  .list h2 { font-size: clamp(1.35rem, 1.15rem + 0.8vw, 1.75rem); }
  .list p { color: var(--muted); line-height: 1.55; }
  .more { color: var(--pine); font-weight: 600; margin-top: 4px; }
</style>
