    <rect x="852" y="510" width="52" height="30" rx="15" fill="#0b3d2e"></rect>
    <rect x="912.75" y="510.75" width="50.5" height="28.5" rx="14.25" fill="none" stroke="#d5ddd8" stroke-width="1.5"></rect>
    <rect x="972.75" y="510.75" width="50.5" height="28.5" rx="14.25" fill="none" stroke="#d5ddd8" stroke-width="1.5"></rect>
    <rect x="852" y="562" width="206" height="44" rx="10" fill="#0b3d2e"></rect>
