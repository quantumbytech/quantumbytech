  /* Times */
  .day-title { font-weight: 600; color: var(--ink); min-height: 1.6em; }
  .tz { margin: 2px 0 16px; font-size: var(--step--1); color: var(--muted); }
  .times { display: grid; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: 8px; }
  .times :global(.time) {
    display: flex;
    flex-direction: column;
