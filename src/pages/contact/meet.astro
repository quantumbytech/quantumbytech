  .agenda { margin-top: 36px; padding-top: 28px; border-top: 1px solid var(--on-pine-line); }
  .agenda h2 { font-size: var(--step-0); font-weight: 600; letter-spacing: 0; color: var(--white); }
  .agenda ul { list-style: none; display: grid; gap: 10px; margin-top: 14px; }
  .agenda li { position: relative; padding-left: 24px; line-height: 1.45; }
