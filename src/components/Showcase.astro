    <rect x="40" y="60" width="820" height="560" rx="14" fill="none" stroke="#d5ddd8"></rect>

    <!-- Phone -->
    <rect x="820" y="140" width="270" height="520" rx="40" fill="#0b3d2e"></rect>
    <rect x="832" y="152" width="246" height="496" rx="30" fill="#fff"></rect>
    <rect x="925" y="164" width="60" height="14" rx="7" fill="#0b3d2e"></rect>
    <rect x="852" y="198" width="96" height="12" rx="3" fill="#0b3d2e"></rect>
    <circle cx="1048" cy="204" r="10" fill="#f3f5f2"></circle>
    <rect x="852" y="228" width="206" height="180" rx="14" fill="#e1f0e6"></rect>
